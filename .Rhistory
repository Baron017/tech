# Change the path to where you stored your data set
setwd("C:/Users/baron/OneDrive/Desktop/tech/projects and datasets")
# Reads data into R and displays the first few rows
library(readxl)
data<- read_excel("cameratrap.xlsx",sheet=1)
head(data)
library(lme4)
# a) All Models
#All GLMs
model1 <- glm(formula=Noseen ~ factor(Habitat)+
factor(Month), data = data,
family = poisson())
model2 <- glm(formula=Noseen ~ factor(Habitat),
data = data, family = poisson())
model3 <- glm(formula=Noseen ~ factor(Month),
data = data, family = poisson())
model4 <- glm(formula=Noseen ~ 1,
data = data, family = poisson())
# AIC for GLMs (note code is different to extract name from GLM and GLMM)
nm <- 4 # Replace by the number of models
Depvarname <- "Noseen" # Replace by the name of dependent variable.
AICvalues <- c()
modelname <- c()
for (i in 1:nm) {
cmodel <- paste("model",i,sep="")
AICvalues <- c(AICvalues,AIC(get(cmodel)))
cname <- toString(get(cmodel)$call[2])
cname <- gsub(Depvarname,"",cname,fixed = TRUE)
cname <- gsub("~","",cname)
cname <- gsub("factor","",cname)
cname <- gsub("[())]","",cname)
cname <- gsub(" ","",cname)
modelname <- c(modelname,cname)
}
AICvaluesr <- round(AICvalues,digits=2)
deltaAIC <-AICvalues-min(AICvalues)
deltaAICr <-round(deltaAIC,digits=2)
AICweight <- round(exp(-deltaAIC/2)/sum(exp(-deltaAIC/2)),digits=2)
AICtable <- data.frame(modelname,AICvaluesr,deltaAICr,AICweight)
colnames(AICtable ) <- c("Model", "AIC","Delta AIC","AIC weight")
AICtable <- AICtable[order(AICtable$`Delta AIC`),]
# Printing table at this stage shows all the GLMs
print(AICtable)
#All GLMMs
model5 <- glmer(formula=Noseen ~
factor(Habitat)+factor(Month)+(1|Camera),
data = data, family = poisson())
model6 <- glmer(formula=Noseen ~
factor(Habitat)+(1|Camera),
data = data, family = poisson())
model7 <- glmer(formula=Noseen ~
factor(Month)+(1|Camera),
data = data, family = poisson())
model8 <- glmer(formula=Noseen ~ (1|Camera),
data = data, family = poisson())
# Add AIC for GLMMs to table (note code is different to extract name from GLM and GLMM)
nr <- 8 # Replace by the last number for random effects model
for (i in ((nm+1):nr)) {
cmodel <- paste("model",i,sep="")
AICvalues <- c(AICvalues,AIC(get(cmodel)))
cname <- toString(get(cmodel)@call[2])
cname <- gsub(Depvarname,"",cname,fixed = TRUE)
cname <- gsub("~","",cname)
cname <- gsub("factor","",cname)
cname <- gsub("[())]","",cname)
cname <- gsub(" ","",cname)
modelname <- c(modelname,cname)
}
AICvaluesr <- round(AICvalues,digits=2)
deltaAIC <-AICvalues-min(AICvalues)
deltaAICr <-round(deltaAIC,digits=2)
AICweight <- round(exp(-deltaAIC/2)/sum(exp(-deltaAIC/2)),digits=2)
AICtable <- data.frame(modelname,AICvaluesr,deltaAICr,AICweight)
colnames(AICtable ) <- c("Model", "AIC","Delta AIC","AIC weight")
AICtable <- AICtable[order(AICtable$`Delta AIC`),]
print(AICtable)
